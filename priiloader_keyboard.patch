+/*
+ * USB keyboard support for the Priiloader 0.10.0 installer.
+ *
+ * ENTER / keypad ENTER = install or confirm (A / +)
+ * ESC / SPACE          = cancel / go back (B / HOME)
+ *
+ * Removal is intentionally NOT mapped to the keyboard to reduce the chance
+ * of accidentally removing Priiloader.
+ */
+enum
+{
+	KBD_INSTALL = (1 << 0),
+	KBD_CANCEL  = (1 << 1)
+};
+
+static volatile u32 _kbd_down = 0;
+static bool _kbd_initialized = false;
+
+static void KBEventHandler(USBKeyboard_event event)
+{
+	if(event.type != USBKEYBOARD_PRESSED)
+		return;
+
+	switch(event.keyCode)
+	{
+		case 0x28: // Enter
+		case 0x58: // Keypad Enter
+			_kbd_down |= KBD_INSTALL;
+			break;
+		case 0x29: // Escape
+		case 0x2C: // Space
+			_kbd_down |= KBD_CANCEL;
+			break;
+		default:
+			break;
+	}
+}
+
+static void KeyboardInit()
+{
+	if(_kbd_initialized)
+		return;
+
+	USB_Initialize();
+	USBKeyboard_Initialize();
+	_kbd_initialized = true;
+}
+
+static void KeyboardPoll()
+{
+	KeyboardInit();
+	if(!USBKeyboard_IsConnected())
+		USBKeyboard_Open(KBEventHandler);
+	USBKeyboard_Scan();
+	usleep(1000);
+}
+
+static u32 KeyboardButtonsDown()
+{
+	u32 pressed = _kbd_down;
+	_kbd_down = 0;
+	return pressed;
+}
